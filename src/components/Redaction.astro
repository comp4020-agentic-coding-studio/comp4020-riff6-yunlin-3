---
// A cut you have to choose to look under. Built on native
// <details>/<summary> so revealing it is a real decision (a click or a
// keypress), not a hover accident, and it works with no JS at all.
//
// The three fields are not free-form: they are what the "Commonplace Book
// of Cuts" assessment requires of every entry, so a cut that cannot fill
// all three has not been thought through yet. `cutById` throws at build
// time on an id with no logged entry.
import { cutById } from "../lib/cuts";

interface Props {
  id: string;
}
const cut = cutById(Astro.props.id);
---

<details class="redaction">
  <summary class="redaction-bar">
    <span class="visually-hidden">Reveal what was cut here</span>
  </summary>
  <dl class="redaction-note">
    <dt>What's missing</dt>
    <dd>{cut.missing}</dd>
    <dt>What it cost</dt>
    <dd>{cut.cost}</dd>
    <dt>What it bought</dt>
    <dd>{cut.bought}</dd>
  </dl>
</details>

<style>
  .redaction {
    display: inline-block;
    vertical-align: baseline;
  }

  .redaction-bar {
    display: inline-block;
    min-width: 9ch;
    background: currentColor;
    border-radius: 0.15em;
    cursor: pointer;
    list-style: none;
  }

  .redaction-bar::-webkit-details-marker {
    display: none;
  }

  .redaction-bar:hover,
  .redaction-bar:focus-visible {
    outline: 2px solid var(--at-color-accent, currentColor);
    outline-offset: 2px;
  }

  .redaction[open] .redaction-bar {
    background: transparent;
    border: 1px dashed currentColor;
  }

  .redaction-note {
    margin-block: 0.5em 0;
    font-size: 0.9em;
  }

  .redaction-note dt {
    font-weight: 600;
    opacity: 0.7;
  }

  .redaction-note dd {
    margin-inline-start: 0;
    margin-block-end: 0.5em;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
